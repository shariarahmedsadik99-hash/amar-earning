# Database URL (Turso)
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# JWT Secret (change this!)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Optional: Base URL for production
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Cloudflare R2 storage (for image uploads)
# Create a bucket at https://dash.cloudflare.com → R2, then generate API tokens.
# Also set a public domain for the bucket (R2 → bucket → Settings → Public access).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=amar-earning
R2_PUBLIC_URL=https://images.your-domain.com
